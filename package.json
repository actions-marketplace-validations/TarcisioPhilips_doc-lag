{
  "name": "doc-lag",
  "version": "0.4.0",
  "description": "Detect documentation that may be stale after a code change, with traceable evidence.",
  "type": "module",
  "license": "MIT",
  "author": "Tarcisio Philips",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarcisioPhilips/doc-lag.git"
  },
  "homepage": "https://github.com/TarcisioPhilips/doc-lag#readme",
  "bugs": {
    "url": "https://github.com/TarcisioPhilips/doc-lag/issues"
  },
  "keywords": [
    "documentation",
    "docs",
    "stale-docs",
    "drift",
    "pull-request",
    "github-action",
    "mcp",
    "mcp-server",
    "cli",
    "ci"
  ],
  "bin": {
    "doc-lag": "dist/cli.js",
    "doc-lag-mcp": "dist/mcp/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "PROJECT_SPEC.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx src/cli.ts scan",
    "mcp": "tsx src/cli.ts mcp",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.2",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
